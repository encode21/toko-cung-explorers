# =============================================================================
# Toko Cung Explorers — CloudPanel / VPS production
# Copy:  cp .env.cloudpanel.example .env
# Then:  docker compose up -d --build
# =============================================================================

# --- Host ports (bind 127.0.0.1 only; nginx reverse-proxy di depan) ---
# Hindari 8080 (nginx CloudPanel), 8088 (tanya-web).
WEB_PORT=8090

NODE_ENV=production

# Browser bundle — di-bake saat `docker compose build`
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Runtime SSR di container
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Opsional
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# LOVABLE_CRON_SECRET=
