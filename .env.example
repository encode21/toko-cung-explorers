# =============================================================================
# Toko Cung Explorers — local / generic
# Copy:  cp .env.example .env
# Then:  docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
# =============================================================================

WEB_PORT=8080

# Browser (Vite) — wajib untuk auth + multiplayer
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Server SSR (boleh sama dengan VITE_* di atas)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Opsional — admin server / NPC AI
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# LOVABLE_CRON_SECRET=

# Official App HTTPS universal link (optional; commerce stays outside World)
VITE_TOKO_CUNG_APP_URL=

# Server-only account gateway. No VITE_ prefix; no tokens in browser storage.
# Local: http://127.0.0.1:8000 (Laravel on this machine). HTTPS required in production.
TOKO_CUNG_API_URL=
# Exact public World origin, no trailing slash. Required in production.
# LAN multi-device: http://<your-lan-ip>:8080 — open the same URL on phone + laptop.
# DEV also accepts the Origin of the URL you actually open (localhost vs LAN IP).
WORLD_ORIGIN=https://world.tokocung.com

# Normal play reads events maintained in Laravel /world-admin.
# MOCK is available only in development when explicitly selected; OFF disables visual events.
VITE_REACTIVE_WORLD_SOURCE=LIVE
