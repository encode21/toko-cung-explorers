# =============================================================================
# Toko Cung Explorers — local / generic
# Copy:  cp .env.example .env
# Then:  docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
# =============================================================================

WEB_PORT=8080

# Browser (Vite) — wajib untuk auth + multiplayer
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Server SSR (boleh sama dengan VITE_* di atas)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Opsional — admin server / NPC AI
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# LOVABLE_CRON_SECRET=
